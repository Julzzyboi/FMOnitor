{
  "name": "fmonitor-webbe-frontend",
  "private": true,
  "description": "Builds the Tailwind CSS for the Thymeleaf templates. Not an app - just the CSS compile step.",
  "scripts": {
    "css": "tailwindcss -i ./input.css -o ../resources/static/css/app.css --minify",
    "css:watch": "tailwindcss -i ./input.css -o ../resources/static/css/app.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
